
/*
 * USB-C host mode (ot2): the RT9470's OTG boost on hsi2c10, the MAX77779
 * charger's chgin-otg regulator on top of it (charger to standby, then the
 * boost, as Google's ext-otg-only use case), the TCPC sourcing VBUS from
 * it as a dual-role port that prefers sink, and the port's data role
 * driving the dwc3 role switch. Source PDO from stock (fixed 5 V, 900 mA).
 */
&hsi2c10 {
	otg_boost: regulator@5b {
		compatible = "omamobile,tegu-rt9471-boost";
		reg = <0x5b>;
		regulator-name = "otg-boost";
	};
};

&hsi2c6 {
	charger@69 {
		compatible = "maxim,max77779-charger";
		reg = <0x69>;
		otg-boost-supply = <&otg_boost>;

		chgin_otg: chgin-otg-regulator {
			regulator-name = "chgin-otg";
		};
	};
};

&usb_tcpc {
	vbus-supply = <&chgin_otg>;

	connector {
		power-role = "dual";
		try-power-role = "sink";
		source-pdos = <PDO_FIXED(5000, 900, PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;

		port {
			typec_hs: endpoint {
				remote-endpoint = <&usb_hs>;
			};
		};
	};
};

&usb {
	port {
		usb_hs: endpoint {
			remote-endpoint = <&typec_hs>;
		};
	};
};
