#!/bin/bash
# SPDX-License-Identifier: MIT
# Bring up the Pixel 9a's GPU, display, haptics, torch, battery gauge and
# Bluetooth controller at boot, hang-safe. All six drivers are in the kernel
# tree and blacklisted for autoload (modprobe.d/omamobile-tegu-guards.conf),
# so this script is the only thing that loads them, in this order, after a
# marker has been written and synced. If the phone hangs in one of the steps,
# the next boot finds the marker, leaves all of it alone and says so; after
# reading the previous boot's log, run "omamobile-tegu-graphics-start --retry".
#
# This is the curated start of the bring-up (device/tegu/bringup) without its
# file-hash manifest, EGL smoke test, mask checks, sddm start and bootloader
# dead-man: the marker is the safety net, as on the Pixel 7 Pro.
#   omamobile-tegu-graphics-start [--retry]
# OMAMOBILE_TEGU_ROOT: a scratch root for the package tests (fake /sys, /proc).
set -uo pipefail

root=${OMAMOBILE_TEGU_ROOT:-}
if [[ -n $root ]]; then
  [[ $root == /* && $root != / && -d $root ]] || exit 2
fi
state=$root/var/lib/omamobile
marker=$state/tegu-graphics-started
dt=$root/proc/device-tree
gpu=$root/sys/bus/platform/devices/1f000000.gpu
decon=$root/sys/bus/platform/devices/19470000.display-controller
torch=$root/sys/class/leds/white:torch
gauge=$root/sys/class/power_supply/max77779-battery
haptics_node=$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43
torch_node=$dt/soc/usi@108b00c0/i2c@108b0000/led-controller@63
bluetooth_node=$dt/soc/usi@155d00c0/serial@155d0000/bluetooth

log() { echo "omamobile-tegu-graphics: $*"; }
loaded() { [[ -d $root/sys/module/$1 ]]; }
# A device-tree node is enabled when it exists and has no status or "okay".
enabled() {
  [[ -d $1 ]] || return 1
  [[ -e $1/status ]] || return 0
  case $(tr -d '\0' < "$1/status") in okay|ok) return 0 ;; *) return 1 ;; esac
}
# Wait for a device to bind to a driver: device dir, driver name, quarter seconds.
bound() {
  local i
  for ((i = 0; i < $3; i++)); do
    [[ $(readlink -f "$1/driver" 2>/dev/null) == */$2 ]] && return 0
    sleep 0.25
  done
  return 1
}

case ${1:-} in
  '') ;;
  --retry) rm -f "$marker" ;;
  *) log "usage: omamobile-tegu-graphics-start [--retry]"; exit 2 ;;
esac

if [[ -e $marker ]]; then
  log "the last start ($(cat "$marker" 2>/dev/null)) never finished; the GPU, display, haptics, torch, gauge and Bluetooth stay off this boot."
  log "after checking the previous boot's log, retry with: omamobile-tegu-graphics-start --retry"
  exit 0
fi
if [[ ! -e $gpu ]]; then
  log "no GPU in this DTB; nothing to do"
  exit 0
fi
# Once per boot: a loaded driver is never unloaded or retried (AGENTS.md).
if loaded panthor || loaded gs_decon; then
  log "already started this boot"
  exit 0
fi

mkdir -p "$state"
# The marker names the step in progress, so a hang is easy to place.
phase() { printf '%s %s\n' "$(date -Is)" "$1" > "$marker"; sync -f "$marker" 2>/dev/null || sync; }
finish() { rm -f "$marker"; sync -f "$state" 2>/dev/null || sync; }
fail() { log "$*"; log "the marker stays: the next boot skips this start until --retry"; exit 1; }

phase gpu
modprobe panthor || fail "panthor failed"
bound "$gpu" panthor 60 || fail "the GPU did not bind to panthor"

# stage=2 is the full driver (the lower stages are bring-up probes); the
# refresh rate and the panel-off behaviour come from modprobe.d.
phase display
modprobe gs_decon stage=2 fbdev=0 || fail "gs_decon failed"
bound "$decon" gs-decon 60 || fail "the display controller did not bind to gs-decon"
up="GPU, display"

if enabled "$haptics_node"; then
  phase haptics
  modprobe cs40l26_vibra || fail "cs40l26_vibra failed"
  up+=", haptics"
else
  log "no haptics in this DTB; skipped"
fi

if enabled "$torch_node"; then
  phase torch
  modprobe leds_lm3644 || fail "leds_lm3644 failed"
  for _ in $(seq 40); do [[ -e $torch/brightness ]] && break; sleep 0.25; done
  if [[ ! -e $torch/brightness ]]; then
    log "no white:torch LED after the driver loaded (see dmesg)"
  elif [[ $(cat "$torch/brightness") != 0 ]]; then
    fail "the torch came up lit; it must start off"
  else
    up+=", torch"
  fi
else
  log "no torch in this DTB; skipped"
fi

phase gauge
modprobe max77779_battery || fail "max77779_battery failed"
for _ in $(seq 40); do [[ -e $gauge/capacity ]] && break; sleep 0.25; done
if [[ -e $gauge/capacity ]]; then
  up+=", gauge $(cat "$gauge/capacity") %"
else
  log "no max77779-battery supply after the driver loaded (see dmesg)"
fi

# The address and the power-on are omamobile-bt-addr@'s, started by udev.
if enabled "$bluetooth_node"; then
  phase bluetooth
  modprobe hci_uart || fail "hci_uart failed"
  up+=", Bluetooth"
else
  log "no Bluetooth in this DTB; skipped"
fi

finish
log "up: $up"
exit 0
