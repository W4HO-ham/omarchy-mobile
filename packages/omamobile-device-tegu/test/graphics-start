#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-tegu-graphics-start in a scratch root: the marker goes down and
# is synced before the first driver loads, the drivers load in order, a
# failure leaves the marker naming the step, and a marker from a previous
# boot keeps every driver off until --retry. No hardware is touched: modprobe,
# sync and sleep are fakes on PATH.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
script=$PWD/bin/omamobile-tegu-graphics-start
fail() { printf 'not ok - graphics-start: %s\n' "$1" >&2; exit 1; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
export OMAMOBILE_TEGU_ROOT=$tmp/root
export TEST_LOG=$tmp/calls
export TEST_ROOT=$OMAMOBILE_TEGU_ROOT
marker=$OMAMOBILE_TEGU_ROOT/var/lib/omamobile/tegu-graphics-started
export TEST_MARKER=$marker
dt=$OMAMOBILE_TEGU_ROOT/proc/device-tree
devices=$OMAMOBILE_TEGU_ROOT/sys/bus/platform/devices
mkdir -p "$tmp/bin" "$devices/1f000000.gpu" "$devices/19470000.display-controller" \
  "$OMAMOBILE_TEGU_ROOT/sys/bus/platform/drivers/panthor" "$OMAMOBILE_TEGU_ROOT/sys/bus/platform/drivers/gs-decon" \
  "$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43" \
  "$dt/soc/usi@108b00c0/i2c@108b0000/led-controller@63" \
  "$dt/soc/usi@155d00c0/serial@155d0000/bluetooth"
printf 'okay\0' > "$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43/status"
export PATH=$tmp/bin:$PATH
# modprobe: the marker must already be on disk; a module "binds" by creating
# what the script waits for; FAIL_MODULE fails that one load.
cat > "$tmp/bin/modprobe" <<'EOF'
#!/bin/bash
set -euo pipefail
test -s "$TEST_MARKER"
grep -qx synced "$TEST_LOG"
echo "$*" >> "$TEST_LOG"
[[ ${FAIL_MODULE:-} != "$1" ]] || exit 1
case $1 in
  panthor) ln -sfn "$TEST_ROOT/sys/bus/platform/drivers/panthor" "$TEST_ROOT/sys/bus/platform/devices/1f000000.gpu/driver" ;;
  gs_decon) ln -sfn "$TEST_ROOT/sys/bus/platform/drivers/gs-decon" "$TEST_ROOT/sys/bus/platform/devices/19470000.display-controller/driver" ;;
  leds_lm3644) mkdir -p "$TEST_ROOT/sys/class/leds/white:torch"; echo "${TORCH_LIT:-0}" > "$TEST_ROOT/sys/class/leds/white:torch/brightness" ;;
  max77779_battery) mkdir -p "$TEST_ROOT/sys/class/power_supply/max77779-battery"; echo 77 > "$TEST_ROOT/sys/class/power_supply/max77779-battery/capacity" ;;
esac
EOF
printf '#!/bin/bash\necho synced >> "$TEST_LOG"\n' > "$tmp/bin/sync"
printf '#!/bin/bash\nexit 0\n' > "$tmp/bin/sleep"
chmod +x "$tmp/bin/"*
reset() {
  : > "$TEST_LOG"
  rm -rf "$marker" "$devices/1f000000.gpu/driver" "$devices/19470000.display-controller/driver" \
    "$OMAMOBILE_TEGU_ROOT/sys/class" "$OMAMOBILE_TEGU_ROOT/sys/module"
}
loads() { grep -v '^synced$' "$TEST_LOG" | cut -d' ' -f1 | tr '\n' ' ' | sed 's/ $//'; }

# A full start: the order, the gs_decon options, the marker gone, the summary
reset
out=$("$script")
[[ ! -e $marker ]] || fail "a finished start leaves the marker"
[[ $(loads) == "panthor gs_decon cs40l26_vibra leds_lm3644 max77779_battery hci_uart" ]] \
  || fail "load order: $(loads)"
grep -q '^gs_decon stage=2 fbdev=0$' "$TEST_LOG" || fail "gs_decon gets the full driver stage"
[[ $out == *"up: GPU, display, haptics, torch, gauge 77 %, Bluetooth"* ]] || fail "summary: $out"

# A failed display load: exit 1, the marker names the step, nothing after it
reset
FAIL_MODULE=gs_decon "$script" >/dev/null && fail "a failed load exits 0"
[[ -s $marker ]] || fail "a failed load removes the marker"
grep -q ' display$' "$marker" || fail "the marker names the failed step: $(cat "$marker")"
[[ $(loads) == "panthor gs_decon" ]] || fail "a failed load went on: $(loads)"

# The next boot with that marker: nothing loads, the hint is printed
: > "$TEST_LOG"
rm -rf "$devices/1f000000.gpu/driver" "$devices/19470000.display-controller/driver"
out=$("$script")
[[ -s $marker && -z $(loads) ]] || fail "a leftover marker did not keep the drivers off"
[[ $out == *"--retry"* ]] || fail "no retry hint"

# --retry clears it and starts again
out=$("$script" --retry)
[[ ! -e $marker && $(loads) == "panthor gs_decon cs40l26_vibra leds_lm3644 max77779_battery hci_uart" ]] \
  || fail "--retry did not start again: $(loads)"

# A torch that comes up lit is a failure that keeps the marker
reset
TORCH_LIT=1 "$script" >/dev/null && fail "a lit torch passed"
grep -q ' torch$' "$marker" || fail "the marker names the torch step"

# A disabled haptics node is skipped, a missing Bluetooth node too
reset
printf 'disabled\0' > "$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43/status"
mv "$dt/soc/usi@155d00c0" "$tmp/bt-node"
out=$("$script")
[[ $(loads) == "panthor gs_decon leds_lm3644 max77779_battery" ]] || fail "disabled nodes were loaded: $(loads)"
[[ $out == *"no haptics in this DTB"* && $out == *"no Bluetooth in this DTB"* ]] || fail "skips are not reported"
printf 'okay\0' > "$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43/status"
mv "$tmp/bt-node" "$dt/soc/usi@155d00c0"

# A driver already loaded this boot is never retried
reset
mkdir -p "$OMAMOBILE_TEGU_ROOT/sys/module/panthor"
out=$("$script")
[[ -z $(loads) && ! -e $marker && $out == *"already started"* ]] || fail "a loaded driver was retried"

# No GPU in the DTB: nothing to do
reset
mv "$devices/1f000000.gpu" "$tmp/gpu"
out=$("$script")
[[ -z $(loads) && ! -e $marker && $out == *"no GPU"* ]] || fail "a missing GPU node was not skipped"
mv "$tmp/gpu" "$devices/1f000000.gpu"

# A bad argument
"$script" --bogus >/dev/null 2>&1 && fail "a bad argument is accepted"
echo 'ok - graphics-start: marker first, order kept, failures named, --retry works'
