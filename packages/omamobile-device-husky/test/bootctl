# Each mutation breaks one guard in a copy of the source; a case must fail.
mutate() {  # name, python replacement (old, new)
  local name=$1 old=$2 new=$3 m="$tmp/mut.c"
  nmut=$((${nmut:-0} + 1))
  python3 - bootctl/omamobile-bootctl.c "$m" "$old" "$new" <<'PY'
import sys
s = open(sys.argv[1]).read()
if s.count(sys.argv[3]) < 1:
    sys.exit("mutation does not apply: " + sys.argv[3])
open(sys.argv[2], 'w').write(s.replace(sys.argv[3], sys.argv[4]))
PY
  build_test "$m" "$tmp/mut$nmut" -w || fail "mutant '$name' compiles"
  if BOOTCTL_BIN="$tmp/mut$nmut" "$0" --cases >/dev/null 2>&1; then
    fail "mutant '$name' passed every case"
  fi
  pass "mutation caught: $name"
}
