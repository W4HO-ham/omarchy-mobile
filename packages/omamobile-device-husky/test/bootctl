#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for omamobile-bootctl (the same file in omamobile-device-husky
# and omamobile-device-tegu). No phone, no block device, no ioctl: the test
# build (-DBOOTCTL_TEST) reads a fake /sys, /proc and /dev under a scratch
# root, its "block devices" are files, and each read-only flag is a file
# beside its device that follows the kernel's rule (a partition is read-only
# when its own flag or its disk's flag is set). The fake phone is guarded as
# the initramfs guards one since #252: no whole-disk node, every disk's own
# flag clear, every partition's own flag set but userdata's. The production
# build is compiled too, and checked to carry none of the test hooks.
#
#   test/bootctl                 build and run every case
#   test/bootctl --mutations     also break each key guard in a copy of the
#                                source and check that a case catches it
#   BOOTCTL_BIN=<test build> test/bootctl --cases   run the cases on a binary
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { [[ -n ${QUIET:-} ]] || printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d)
bgpids=()
# A case that fails can leave a stopped or hung tool behind: kill it and its
# relock child, so neither outlives the test or holds the binary.
cleanup() { local p; for p in "${bgpids[@]}"; do pkill -KILL -P "$p" 2>/dev/null || true; kill -KILL "$p" 2>/dev/null || true; done; rm -rf "$tmp"; }
trap cleanup EXIT

codename=$(sed -n 's/^#define BOOTCTL_CODENAME[[:space:]]*"\(.*\)"$/\1/p' bootctl/bootctl-device.h)
compatible=$(sed -n 's/^#define BOOTCTL_COMPATIBLE[[:space:]]*"\(.*\)"$/\1/p' bootctl/bootctl-device.h)
[[ -n $codename && -n $compatible ]] || fail "bootctl/bootctl-device.h names a codename and a compatible"

build_test() { ${CC:-cc} -O2 -Wall -Wextra ${3:--Werror} -DBOOTCTL_TEST -Ibootctl -o "$2" "$1"; }

# A phone as the storage guard leaves it: sda (main LUN) with persist and
# userdata, sdb with abl and a dtbo_b, sdd with devinfo and three siblings. No whole-disk
# node, every disk's own flag clear, every partition's set except userdata's.
mkroot() {
  local r=$1 ver=${2:-15} major=${3:-3}
  rm -rf "$r"; mkdir -p "$r/dev" "$r/proc/self" "$r/sys/firmware/devicetree/base"
  printf '%s\0google,soc\0' "$compatible" > "$r/sys/firmware/devicetree/base/compatible"
  printf 'androidboot.hardware = "x"\nandroidboot.slot_suffix = "_b"\n' > "$r/proc/bootconfig"
  echo '25 1 259:34 / / rw,relatime shared:1 - ext4 /dev/sda34 rw' > "$r/proc/self/mountinfo"
  local d p n
  for d in sda sdb sdd; do mkdir -p "$r/sys/block/$d"; echo 0 > "$r/dev/$d.ro"; done
  mkpart() {  # disk part name ro
    mkdir -p "$r/sys/block/$1/$2/holders"; echo 1 > "$r/sys/block/$1/$2/partition"
    printf 'MAJOR=8\nMINOR=1\nDEVNAME=%s\nDEVTYPE=partition\nPARTN=1\nPARTNAME=%s\n' "$2" "$3" > "$r/sys/block/$1/$2/uevent"
    head -c 8192 /dev/zero > "$r/dev/$2"; echo "$4" > "$r/dev/$2.ro"
  }
  mkpart sda sda1 persist 1
  mkpart sda sda34 userdata 0
  mkpart sdb sdb1 abl 1
  mkpart sdb sdb2 dtbo_b 1
  mkpart sdd sdd1 devinfo 1
  mkpart sdd sdd2 pinfo 1
  mkpart sdd sdd3 blenv 1
  mkpart sdd sdd4 mfg_data 1
  # devinfo: DEVI, 3.<ver>, ABL-owned bytes we must never print or change,
  # slot A 02 1a 00 00 (successful, fastboot-ok, high bit), slot B 00 1c 00 00
  # (active, fastboot-ok, high bit; not successful): the 9a's 2026-10-22 bytes.
  python3 - "$r/dev/sdd1" "$ver" "$major" <<'PY'
import struct, sys
d = bytearray(8192)
for i in range(8192):
    d[i] = (i * 37 + 11) & 0xff
d[0:8] = struct.pack('<IHH', 0x49564544, int(sys.argv[3]), int(sys.argv[2]))
d[0x30:0x38] = bytes([0x02, 0x1a, 0, 0, 0x00, 0x1c, 0, 0])
d[0x40:0x44] = bytes([0xde, 0xad, 0xbe, 0xef])
open(sys.argv[1], 'wb').write(d)
PY
}

flags() { local r=$1 f out=""; for f in sdd sdd1 sdd2 sdd3 sdd4 sdb sdb1 sda1; do out+="$f=$(<"$r/dev/$f.ro") "; done; echo "$out"; }
all_ro="sdd=0 sdd1=1 sdd2=1 sdd3=1 sdd4=1 sdb=0 sdb1=1 sda1=1 "
# No case may ever change a disk's flag: the window is devinfo's alone.
no_disk_flag() { ! grep -q '^sd[a-z] ' "$1/ro.log" 2>/dev/null; }
expect_bytes="02 1a 00 00 00 1c 00 00"

cases() {
  local bin=$1 r="$tmp/root" out st
  run() { BOOTCTL_TEST_ROOT="$r" "$bin" "$@"; }
  write() { run mark-b-successful --write --codename "$codename" --expect "$expect_bytes" "$@"; }
  unchanged() { cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "$1: devinfo changed"; [[ $(flags "$r") == "$all_ro" ]] || fail "$1: flags left as $(flags "$r")"; no_disk_flag "$r" || fail "$1: a disk flag was changed"; }
  refused() {  # name, then the command; must exit 1 or 2 and change nothing
    local name=$1; shift
    st=0; out=$("$@" 2>&1) || st=$?
    [[ $st == 1 || $st == 2 ]] || fail "$name: exit $st, want a refusal ($out)"
    unchanged "$name"
    pass "$name"
  }
  fresh() { mkroot "$r" "${1:-15}" "${2:-3}"; cp "$r/dev/sdd1" "$tmp/orig"; }
  opened() { grep -qx 'sdd1 0' "$r/ro.log" 2>/dev/null; }

  # status: version and the eight slot bytes, nothing else from the partition
  fresh
  out=$(run status 2>&1) || fail "status runs ($out)"
  grep -q "^bytes 0x30-0x37: $expect_bytes$" <<<"$out" || fail "status prints the slot bytes ($out)"
  grep -q '^devinfo version 3.15 ' <<<"$out" || fail "status prints the version"
  grep -q '^storage guard: holding$' <<<"$out" || fail "status sees the guard holding"
  ! grep -qi 'de ad\|dead\|be ef' <<<"$out" || fail "status prints bytes from outside 0x30-0x37"
  unchanged "status"
  pass "status prints the version and the eight slot bytes, and nothing else"

  # dry run: plans one byte, writes nothing, leaves every flag set
  out=$(run mark-b-successful 2>&1) || fail "the dry run passes its checks ($out)"
  grep -q '^planned: byte 0x35 1c -> 1e (slot b successful), nothing else$' <<<"$out" || fail "the dry run plans 0x35 1c -> 1e ($out)"
  grep -q -- "--write --codename $codename --expect \"$expect_bytes\"" <<<"$out" || fail "the dry run prints the write command"
  ! grep -qi 'de ad\|dead\|be ef' <<<"$out" || fail "the dry run prints bytes from outside 0x30-0x37"
  unchanged "dry run"
  pass "a dry run plans one byte and writes nothing"

  # refusals before any window
  fresh 11; refused "devinfo version 3.11 is refused (dry run)" run mark-b-successful
  fresh 11; refused "devinfo version 3.11 is refused (write)" write
  fresh 16; refused "devinfo version 3.16 (a newer minor) is refused" write
  fresh 15 4; refused "devinfo version 4.15 (another major) is refused" write
  fresh; printf 'XXXX' | dd of="$r/dev/sdd1" conv=notrunc status=none; cp "$r/dev/sdd1" "$tmp/orig"
  refused "bad magic is refused" write
  fresh; printf 'google,other-phone\0' > "$r/sys/firmware/devicetree/base/compatible"; refused "another board is refused" write
  fresh; sed -i 's/_b"/_a"/' "$r/proc/bootconfig"; refused "a boot from slot a is refused" write
  fresh; refused "--write without --expect is refused" run mark-b-successful --write --codename "$codename"
  fresh; refused "--write with other bytes in --expect is refused" run mark-b-successful --write --codename "$codename" --expect "02 1a 00 00 01 1c 00 00"
  fresh; refused "a wrong codename is refused" run mark-b-successful --write --codename not-"$codename" --expect "$expect_bytes"
  fresh; refused "no codename and no terminal is refused" setsid -w env BOOTCTL_TEST_ROOT="$r" "$bin" mark-b-successful --write --expect "$expect_bytes"
  fresh; printf '\x1d' | dd of="$r/dev/sdd1" bs=1 seek=$((0x35)) conv=notrunc status=none; cp "$r/dev/sdd1" "$tmp/orig"
  refused "an unbootable slot b is refused" write --expect "02 1a 00 00 00 1d 00 00"
  fresh; printf '\x18' | dd of="$r/dev/sdd1" bs=1 seek=$((0x35)) conv=notrunc status=none; cp "$r/dev/sdd1" "$tmp/orig"
  refused "an inactive slot b is refused" write --expect "02 1a 00 00 00 18 00 00"
  fresh; printf '\x1e' | dd of="$r/dev/sdd1" bs=1 seek=$((0x35)) conv=notrunc status=none; cp "$r/dev/sdd1" "$tmp/orig"
  out=$(write --expect "02 1a 00 00 00 1e 00 00" 2>&1) || fail "an already marked slot b is not an error ($out)"
  grep -q 'already marked successful' <<<"$out" || fail "an already marked slot b says so"
  unchanged "already marked"; pass "an already marked slot b writes nothing"
  fresh; echo '30 1 8:49 / /mnt ro - vfat /dev/sdd1 ro' >> "$r/proc/self/mountinfo"; refused "a mounted devinfo is refused" write
  fresh; mkdir "$r/sys/block/sdd/sdd1/holders/dm-0"; refused "a held devinfo is refused" write
  fresh; mkdir -p "$r/sys/block/sdd/holders/md0"; refused "a held boot LUN is refused" write
  fresh; mkdir "$r/sys/block/sdd/sdd3/holders/loop0"; refused "a held sibling is refused" write
  fresh; sed -i 's/PARTNAME=pinfo/PARTNAME=devinfo/' "$r/sys/block/sdd/sdd2/uevent"; refused "two devinfo partitions are refused" write
  fresh; sed -i 's/PARTNAME=devinfo/PARTNAME=devinfo2/' "$r/sys/block/sdd/sdd1/uevent"; refused "no devinfo partition is refused" write
  fresh; echo 1 > "$r/dev/sdd.ro"; st=0; out=$(write 2>&1) || st=$?
  [[ $st == 1 && $(<"$r/dev/sdd.ro") == 1 && ! -s $r/ro.log ]] && cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a boot LUN read-only at the disk level is refused (exit $st)"
  grep -q 'from before the boot-LUN guard' <<<"$out" || fail "the disk-level refusal says why ($out)"
  out=$(run status 2>&1); grep -q '^storage guard: NOT as expected' <<<"$out" || fail "status sees a boot LUN read-only at the disk level"
  pass "a boot LUN read-only at the disk level (an initramfs from before #252) is refused: devinfo can't be opened alone there"
  fresh; rm "$r/dev/sdd.ro"; st=0; write >/dev/null 2>&1 || st=$?
  [[ $st == 1 && ! -s $r/ro.log ]] && cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a boot LUN whose own flag can't be read is refused (exit $st)"
  pass "a boot LUN whose own flag can't be read is refused"
  for d in sdd sdb; do
    fresh; : > "$r/dev/$d"; chmod 000 "$r/dev/$d"; refused "a whole-disk node for $d, even at mode 0000, is refused" write
  done
  fresh; ln -s sdd1 "$r/dev/sdd"; refused "a symlink where the boot LUN's node would be is refused" write
  fresh; echo 0 > "$r/dev/sda1.ro"; st=0; write >/dev/null 2>&1 || st=$?
  [[ $st == 1 ]] && cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a writable persist is refused"
  pass "a writable partition outside the allowlist is refused"
  fresh; echo 0 > "$r/dev/sdb2.ro"; st=0; write >/dev/null 2>&1 || st=$?
  [[ $st == 1 && ! -s $r/ro.log ]] && cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a writable dtbo_b on a boot LUN is refused (exit $st)"
  pass "the allowlist's names count on the main LUN only: a writable dtbo_b on a boot LUN is refused"
  fresh; : > "$r/dev/sda"; chmod 600 "$r/dev/sda"; refused "a usable main-LUN node is refused" write
  fresh; : > "$r/dev/sda"; chmod 000 "$r/dev/sda"; out=$(run mark-b-successful 2>&1) || fail "a mode-0000 main-LUN node (the udev rule) is accepted ($out)"
  pass "a mode-0000 main-LUN node, as the udev rule leaves it, is accepted"
  fresh; mkdir "$r/elsewhere"; : > "$r/elsewhere/sdd"; exec 7<>"$r/elsewhere/sdd"
  refused "another process with the boot LUN open for writing, through a node made elsewhere, is refused" write; exec 7>&-
  fresh; exec 7<>"$r/dev/sdd1"; refused "another process with devinfo open for writing is refused" write; exec 7>&-
  fresh; exec 7<>"$r/dev/sdd3"; refused "another process with a sibling open for writing is refused" write; exec 7>&-
  fresh; mkdir "$r/elsewhere"; : > "$r/elsewhere/sdd"; exec 7<"$r/elsewhere/sdd"
  out=$(run mark-b-successful 2>&1) || fail "a reader of the boot LUN is no reason to refuse ($out)"; exec 7<&-
  pass "a process reading the boot LUN is not a reason to refuse"

  # a sibling whose own flag is clear is plain to see now (no disk flag hides
  # it): each in turn, so directory order can't hide a skipped one
  for sib in sdd2 sdd3 sdd4; do
    fresh; echo 0 > "$r/dev/$sib.ro"
    out=$(run status 2>&1); grep -q '^storage guard: NOT as expected' <<<"$out" || fail "status sees $sib's flag clear"
    st=0; out=$(write 2>&1) || st=$?
    [[ $st == 1 ]] || fail "$sib with its own flag clear is refused (exit $st: $out)"
    grep -q "$sib (.*) is not read-only" <<<"$out" || fail "$sib is named ($out)"
    [[ ! -s $r/ro.log ]] || fail "$sib: a flag was changed: $(cat "$r/ro.log")"
    cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "the $sib case wrote devinfo"
  done
  pass "each sibling whose own flag is clear is refused before any flag changes"
  fresh; rm "$r/dev/sdd3.ro"; st=0; write >/dev/null 2>&1 || st=$?
  [[ $st == 1 && ! -s $r/ro.log ]] && cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a sibling whose flag can't be read is refused before the window (exit $st)"
  pass "a sibling whose flag can't be read is refused"
  fresh; echo 0 > "$r/dev/sdd1.ro"; st=0; out=$(write 2>&1) || st=$?
  [[ $st == 1 && ! -s $r/ro.log ]] && grep -q "sdd1 (devinfo) is not read-only" <<<"$out" || fail "devinfo with its own flag clear is refused (exit $st: $out)"
  cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "the devinfo-flag case wrote devinfo"
  pass "devinfo with its own flag already clear is refused: the guard did not set it"

  # the guard changes between the last check and the window
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=late-disk-ro write 2>&1) || st=$?
  [[ $st == 3 ]] && grep -q "sdd's own read-only flag is set or unreadable" <<<"$out" || fail "a disk flag set at the last moment stops the write (exit $st: $out)"
  opened && fail "a late disk flag: devinfo was made writable"
  no_disk_flag "$r" || fail "a late disk flag: the tool changed a disk flag"
  cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a late disk flag: devinfo written"
  [[ $(<"$r/dev/sdd1.ro") == 1 ]] || fail "a late disk flag left devinfo's flag clear"
  pass "a disk flag set between the checks and the window stops the write, and the tool leaves that flag alone"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=late-devinfo-open write 2>&1) || st=$?
  [[ $st == 3 ]] && grep -q "devinfo's own read-only flag was already clear" <<<"$out" || fail "devinfo opened by someone else at the last moment stops the write (exit $st: $out)"
  opened && fail "a late open devinfo: the tool cleared the flag itself"
  cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a late open devinfo: devinfo written"
  [[ $(flags "$r") == "$all_ro" ]] || fail "a late open devinfo left $(flags "$r")"
  pass "devinfo's flag found clear at the window stops the write, and the tool sets it again"

  # the write: exactly bit 0x02 of byte 0x35, read back, every flag set again
  fresh
  out=$(write 2>&1) || fail "the write succeeds ($out)"
  diffs=$(cmp -l "$tmp/orig" "$r/dev/sdd1" || true)
  [[ $(wc -l <<<"$diffs") == 1 ]] || fail "the write changed more than one byte: $diffs"
  read -r off old new <<<"$diffs"
  [[ $off == $((0x35 + 1)) ]] || fail "the write changed byte $((off - 1)), not 0x35"
  (( (8#$old ^ 8#$new) == 2 )) || fail "the write changed byte 0x35 by more than bit 0x02"
  [[ $(flags "$r") == "$all_ro" ]] || fail "after the write the flags are $(flags "$r")"
  no_disk_flag "$r" || fail "the write changed a disk flag: $(cat "$r/ro.log")"
  [[ $(sort -u "$r/ro.log" | tr '\n' ',') == "sdd1 0,sdd1 1," ]] || fail "the write touched a flag other than devinfo's: $(tr '\n' ',' < "$r/ro.log")"
  grep -q "^before 0x30-0x37: $expect_bytes$" <<<"$out" || fail "the write prints the bytes before"
  grep -q '^after  0x30-0x37: 02 1a 00 00 00 1e 00 00$' <<<"$out" || fail "the write prints the bytes after"
  ! grep -qi 'de ad\|dead\|be ef' <<<"$out" || fail "the write prints bytes from outside 0x30-0x37"
  pass "a write flips bit 0x02 of byte 0x35 alone, reads it back, and touches no flag but devinfo's"
  fresh; out=$(BOOTCTL_TEST_FAULT=no-child-relock write 2>&1) || fail "the write succeeds without the child's relock ($out)"
  [[ $(flags "$r") == "$all_ro" ]] || fail "without the child's relock the flags are $(flags "$r")"
  pass "the tool sets devinfo's flag again itself, without the relock child"
  out=$(write --expect "02 1a 00 00 00 1e 00 00" 2>&1) || fail "a second run is a no-op ($out)"
  grep -q 'already marked successful' <<<"$out" || fail "a second run says already marked"
  pass "a second run writes nothing"

  # failures inside the window
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=corrupt-write write 2>&1) || st=$?
  [[ $st == 3 ]] || fail "a read-back mismatch fails with 3 (exit $st: $out)"
  grep -q 'VERIFY FAILED' <<<"$out" && grep -q 'restored: devinfo reads back as it was before' <<<"$out" || fail "a mismatch says it restored ($out)"
  unchanged "read-back mismatch"; pass "a read-back mismatch restores the original, sets every flag, and fails"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=write-fails write 2>&1) || st=$?
  [[ $st == 3 ]] || fail "a failed write fails with 3 (exit $st: $out)"
  unchanged "failed write"; pass "a failed write leaves devinfo as it was and sets every flag"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=corrupt-write,restore-noop write 2>&1) || st=$?
  [[ $st == 4 ]] && grep -q 'RESTORE FAILED: devinfo does not read back as before' <<<"$out" || fail "a restore that doesn't land fails with 4 (exit $st: $out)"
  [[ $(flags "$r") == "$all_ro" ]] || fail "after a failed restore the flags are $(flags "$r")"
  pass "a restore that doesn't read back fails with 4, and every flag is set"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=change-under write 2>&1) || st=$?
  [[ $st == 3 ]] && grep -q 'devinfo changed since it was checked' <<<"$out" || fail "devinfo changed inside the window stops the write (exit $st: $out)"
  [[ $(od -An -tx1 -j $((0x35)) -N1 "$r/dev/sdd1" | tr -d ' ') == 1c ]] || fail "devinfo changed underneath, and byte 0x35 was written anyway"
  [[ $(flags "$r") == "$all_ro" ]] || fail "after a change underneath the flags are $(flags "$r")"
  pass "devinfo changed between the checks and the write: nothing written"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=part-relock-ignored write 2>&1) || st=$?
  [[ $st == 5 ]] && grep -q 'FAILED to set devinfo read-only again' <<<"$out" || fail "a devinfo flag that won't set again fails with 5 (exit $st: $out)"
  pass "a devinfo flag that doesn't read back read-only fails loudly (exit 5)"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=child-fails write 2>&1) || st=$?
  [[ $st == 5 ]] && grep -q 'the relock child failed' <<<"$out" || fail "a failed relock child fails with 5 (exit $st: $out)"
  pass "a relock child that fails makes the tool fail loudly (exit 5)"
  fresh; st=0; out=$(BOOTCTL_TEST_FAULT=fork-fails write 2>&1) || st=$?
  [[ $st == 3 ]] && grep -q "can't start the relock child" <<<"$out" || fail "no relock child, no window (exit $st: $out)"
  [[ ! -s $r/ro.log ]] || fail "without a relock child a flag was changed: $(cat "$r/ro.log")"
  unchanged "no relock child"; pass "without a relock child no flag changes"

  waitro() { local i; for i in $(seq 50); do [[ $(flags "$r") == "$all_ro" ]] && return 0; sleep 0.1; done; return 1; }
  for f in kill-before-write kill-after-write; do
    fresh; st=0; BOOTCTL_TEST_FAULT=$f write >/dev/null 2>&1 || st=$?
    [[ $st == 137 ]] || fail "$f: the tool was not killed (exit $st)"
    opened || fail "$f: the window never opened, so the restore proves nothing"
    waitro || fail "$f: the flags stayed $(flags "$r") after the tool was killed"
    no_disk_flag "$r" || fail "$f: a disk flag was changed"
    pass "$f: the relock child sets devinfo read-only again"
  done
  cmp -s "$r/dev/sdd1" "$tmp/orig" && fail "kill-after-write: the fake write did not happen"
  # exec, so $! is the tool itself and not a subshell around it
  bgwrite() { ( exec env BOOTCTL_TEST_ROOT="$r" "$@" "$bin" mark-b-successful --write --codename "$codename" --expect "$expect_bytes" >/dev/null 2>&1 ) & pid=$!; bgpids+=("$pid"); }
  waitopen() { local i; for i in $(seq 100); do opened && return 0; sleep 0.05; done; return 1; }
  stopped() { local i; for i in $(seq 100); do [[ $(awk '{print $3}' /proc/$1/stat 2>/dev/null) == T ]] && return 0; sleep 0.05; done; return 1; }
  fresh; bgwrite BOOTCTL_TEST_FAULT=hang-in-window BOOTCTL_TEST_RELOCK_MS=300
  waitopen || { kill -9 $pid; fail "a hung tool: the window never opened"; }
  waitro || { kill -9 $pid; fail "a hung tool: the relock child did not set the flags after its timeout"; }
  kill -0 $pid 2>/dev/null || fail "hang-in-window: the tool exited instead of hanging"
  kill -9 $pid; wait $pid 2>/dev/null || true
  cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "hang-in-window wrote devinfo"
  pass "a hung tool: the window opened, and the relock child set devinfo's flag after its timeout"

  # Stopped before the window opens, longer than the timeout: the child must
  # still be watching when the window opens, and relock at once on SIGKILL.
  fresh; bgwrite BOOTCTL_TEST_FAULT=stop-before-open,hang-in-window BOOTCTL_TEST_RELOCK_MS=2000
  stopped $pid || { kill -9 $pid; fail "stop-before-open: the tool never stopped"; }
  sleep 2.5
  [[ ! -s $r/ro.log ]] || { kill -9 $pid; fail "stop-before-open: a flag changed while stopped: $(cat "$r/ro.log")"; }
  kill -CONT $pid
  waitopen || { kill -9 $pid; fail "stop-before-open: the window never opened after SIGCONT"; }
  kill -9 $pid; wait $pid 2>/dev/null || true
  for i in $(seq 10); do [[ $(flags "$r") == "$all_ro" ]] && break; sleep 0.1; done
  [[ $(flags "$r") == "$all_ro" ]] || fail "stopped before the window, then killed in it: the flags are $(flags "$r") 1 s later"
  pass "a stop longer than the timeout before the window: the child still relocks at once when the tool is killed in it"

  # Stopped right after arming the child: the child relocks every timeout, so
  # the window that opens after SIGCONT is closed again while the tool hangs.
  fresh; bgwrite BOOTCTL_TEST_FAULT=stop-after-open,hang-in-window BOOTCTL_TEST_RELOCK_MS=300
  stopped $pid || { kill -9 $pid; fail "stop-after-open: the tool never stopped"; }
  sleep 1; kill -CONT $pid
  waitopen || { kill -9 $pid; fail "stop-after-open: the window never opened"; }
  waitro || { kill -9 $pid; fail "stop-after-open: the window stayed open with the tool hung (the child stopped watching)"; }
  kill -0 $pid 2>/dev/null || fail "stop-after-open: the tool exited instead of hanging"
  kill -9 $pid; wait $pid 2>/dev/null || true
  pass "a stop after the child is armed: the child keeps relocking until the tool is gone"

  # The prompt can take minutes: a writer or a guard change during it stops the write.
  for change in writer guard; do
    fresh; bgwrite BOOTCTL_TEST_FAULT=hold-after-codename
    for i in $(seq 100); do [[ -e $r/at-prompt ]] && break; sleep 0.05; done
    [[ -e $r/at-prompt ]] || { kill -9 $pid; fail "hold-after-codename never reached the prompt"; }
    if [[ $change == writer ]]; then exec 7<>"$r/dev/sdd1"; else echo 0 > "$r/dev/sda1.ro"; fi
    touch "$r/go"; st=0; wait $pid || st=$?
    [[ $change == writer ]] && exec 7>&-
    [[ $st == 1 ]] || fail "a $change change during the prompt: exit $st, want a refusal"
    [[ ! -s $r/ro.log ]] || fail "a $change change during the prompt: a flag changed"
    cmp -s "$r/dev/sdd1" "$tmp/orig" || fail "a $change change during the prompt: devinfo written"
  done
  pass "a writer or a guard change while the codename prompt waits stops the write"

  fresh; bgwrite BOOTCTL_TEST_FAULT=hang-in-window
  waitopen || { kill -9 $pid; fail "hang-in-window never opened the window"; }
  kill -INT $pid; kill -TERM $pid; kill -HUP $pid; sleep 0.3
  kill -0 $pid 2>/dev/null || fail "SIGINT, SIGTERM or SIGHUP stopped the tool inside the window"
  kill -9 $pid; wait $pid 2>/dev/null || true
  waitro || fail "after SIGKILL inside the window the flags are $(flags "$r")"
  pass "^C, SIGTERM and SIGHUP wait out the window; SIGKILL leaves the relock to the child"
}

